root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

# EF Core migration'ları üretilmiş koddur (CRLF ve BOM ile yazılır); dotnet format ve analizörler atlar
[**/Migrations/*.cs]
generated_code = true

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
